  "narrative": {
    "northStar": "The Private Chart Workspace",
    "overview": "This record applies only to the private kundli workspace, governed by supplied-flames-kundli-2026. Warm white surfaces, graphite text, restrained champagne gold and DM Sans support a dense but calm working chart. The official supplied wordmark and emblem remain the identity assets.\n\nThe recorded implementation is public/kundli.css and public/kundli.js, reviewed at desktop and mobile sizes. The existing marketing identity in public/styles.css remains outside this record. Print styles exist, but print/PDF output was not visually verified and is not certified by this design record.",
    "keyCharacteristics": [
      "Fine borders and tonal separation rather than card shadows.",
      "Compact sans-serif hierarchy with chart geometry as the visual anchor.",
      "Desktop sidebar; mobile stacked cards and persistent bottom navigation.",
      "Official wordmark and emblem, without replacement logo artwork."
    ],
    "rules": [
      {
        "name": "The Scoped Palette Rule",
        "body": "These tokens describe the kundli workspace; the marketing stylesheet retains its own palette and typography.",
        "section": "colors"
      },
      {
        "name": "The Border Before Shadow Rule",
        "body": "Use the existing border and tonal vocabulary for workspace containers rather than adding raised card shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep this system scoped to the kundli workspace.",
      "Do use the supplied official wordmark and emblem assets.",
      "Do preserve calculated placements, legends and accessible house summaries.",
      "Do keep the expanded mobile chart scrollable at its readable fixed drawing width.",
      "Do retain visible keyboard focus and semantic headings."
    ],
    "donts": [
      "Don't apply this record as a marketing-site redesign.",
      "Don't shrink the expanded chart to fit a phone at the expense of placement legibility.",
      "Don't substitute illustrative mockup values for calculated data.",
      "Don't describe the print/PDF presentation as reviewed until it has been rendered and checked."
    ]
  }
