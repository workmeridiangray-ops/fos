{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flames-of-shiva",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "account_id": "348471314fadbd57e39a68b2eadb5984",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flames-of-shiva",
      "database_id": "acd61056-a1ff-42d1-aea3-96dc1512d05d",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "flames-of-shiva-private"
    }
  ],
  "ratelimits": [
    {
      "name": "API_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    {
      "name": "AUTH_LIMIT",
      "namespace_id": "1002",
      "simple": {
        "limit": 15,
        "period": 60
      }
    },
    {
      "name": "CODE_LIMIT",
      "namespace_id": "1003",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "vars": {
    "APP_ORIGIN": ""
  }
}
